# GLM-5.2 R9 adaptive-MTP / FULL-CUDA — four-node launch configuration.
#
# Copy to r9.env and replace EVERY <...> placeholder with a real value.
# start-node.sh refuses to render or launch while any placeholder remains.
#
#   cp runtime/r9.env.example runtime/r9.env
#   $EDITOR runtime/r9.env
#
# Nothing in this file is a secret. Do not put tokens, keys or passwords here;
# nothing in this stack consumes one.

# ---------------------------------------------------------------------------
# 1. Image
# ---------------------------------------------------------------------------
# Pin the registry DIGEST, not the tag. Get it from release-manifest.json or
# from `docker buildx imagetools inspect` after a pull.
IMAGE_REF="ghcr.io/0xdfi/glm-5.2-r9-adaptive-mtp-full-cuda-4x-dgx-spark@sha256:<GHCR_DIGEST>"

# Container name used on this node. Any stable name; must differ per role only
# if you run head and worker on the same host (you should not).
CONTAINER_NAME="<CONTAINER_NAME>"

# ---------------------------------------------------------------------------
# 2. Cluster network — all four nodes must agree
# ---------------------------------------------------------------------------
# Address of node 0 (Ray head + API server) on the PRIVATE cluster network.
HEAD_NODE_IP="<HEAD_NODE_IP>"

# Address this node advertises to the cluster. On node 0 this equals HEAD_NODE_IP.
NODE_IP="<THIS_NODE_IP>"

# Ray GCS port on the head node.
RAY_PORT="<RAY_PORT>"

# The vLLM OpenAI-compatible server binds here. THIS MUST BE A PRIVATE ADDRESS.
# There is no authentication on this endpoint. Binding it to a routable
# interface exposes an unauthenticated LLM to whoever can reach it.
API_BIND_ADDR="<API_BIND_ADDR>"
API_PORT="<API_PORT>"

# NIC used for NCCL/Gloo control traffic (e.g. the RoCE-capable interface).
NCCL_SOCKET_IFNAME="<NCCL_SOCKET_IFNAME>"
GLOO_SOCKET_IFNAME="<GLOO_SOCKET_IFNAME>"

# RDMA HCAs for NCCL, comma-separated, as reported by `ibv_devinfo`.
NCCL_IB_HCA="<NCCL_IB_HCA>"

# ---------------------------------------------------------------------------
# 3. Host paths
# ---------------------------------------------------------------------------
# GLM-5.2 weights, downloaded separately. Mounted READ-ONLY at /models.
MODEL_DIR="<HOST_MODEL_DIR>"

# Writable directory for persistent JIT caches (vLLM, b12x CuTe, Triton,
# Inductor, torch extensions). Survives container restarts; saves a full
# cold-compile on every start. Mounted read-write at /cache.
JIT_CACHE_DIR="<HOST_JIT_CACHE_DIR>"

# ---------------------------------------------------------------------------
# 4. Runtime envelope — change these only with measurements in hand
# ---------------------------------------------------------------------------
# Named KV profile. Only these two pairs are allowed; max_model_len and
# kv_cache_memory_bytes are a MATCHED PAIR, not two independent knobs.
#   520k -> max_model_len=520000, kv_cache_memory_bytes=8410000000  (qualified;
#           measured physical KV pool 525,887 tokens)
#   550k -> max_model_len=550000, kv_cache_memory_bytes=8850000000  (prior
#           envelope; the head node was OOM-killed under this profile with the
#           nine-shape FULL graph set — see docs/BENCHMARKS.md §5)
R9_PROFILE="520k"

# Concurrency. ENFORCED at exactly 3: it is the multiplier that defines the
# nine-shape FULL-graph coverage set the load-time assertion checks.
MAX_NUM_SEQS="3"

# Speculation. MTP_K must equal the ladder's top rung.
MTP_K="5"
VLLM_ADAPTIVE_SPEC_DEPTHS="2,4,5"
ADAPTIVE_SPEC_WINDOW="32"

# CUDA graph capture sizes. Must cover every (depth+1) x n shape for
# depth in the ladder and n in 1..MAX_NUM_SEQS.
CUDAGRAPH_SIZES="6,12,18"

# Telemetry. Mandatory: this build refuses to launch with it disabled.
VLLM_MTP_INSTRUMENT="1"
VLLM_MTP_INSTRUMENT_WINDOW="32"

# Batching / prefill. The memory floor measurements in docs/BENCHMARKS.md were
# taken at 1024. Raising these without re-measuring risks a host OOM kill.
MAX_NUM_BATCHED_TOKENS="1024"
LONG_PREFILL_TOKEN_THRESHOLD="1024"
DECODE_PREFILL_TOKEN_BUDGET="1024"
IDLE_PREFILL_TOKEN_BUDGET="1024"
MAX_LONG_PREFILLS_PER_STEP="1"

# Parallelism. TP4 x DCP2 x PP1 across four nodes, one GB10 per node.
TENSOR_PARALLEL_SIZE="4"
DECODE_CONTEXT_PARALLEL_SIZE="2"
PIPELINE_PARALLEL_SIZE="1"
DCP_COMM_BACKEND="a2a"

# Served model name presented by /v1/models.
SERVED_MODEL_NAME="glm-5.2"
